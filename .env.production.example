# Copy this file to .env on the server. Do not overwrite your existing .env blindly.
NODE_ENV=production
# Port inside container (Compose fixes this to 3002).
PORTAPP=3002
# Use private server IP for LAN access; localhost is for a reverse proxy on this host.
API_BIND_IP=127.0.0.1
API_HOST_PORT=3002

# Existing MySQL database. Create the database before running migrations.
# MySQL on the Docker host: DB_HOST=host.docker.internal
# MySQL on another machine: use that machine's LAN IP.
# 127.0.0.1 inside a container points to the container itself.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_DIALECT=mysql

# FRONTEND URL(s), not the backend port. No trailing slash.
CLIENT_WEB_URL=http://10.10.200.103:3577
CORS_ORIGINS=http://10.10.200.103:3577

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Leave blank until external HTTPS is ready. Required for sending images.
PUBLIC_BASE_URL=
JWT_SECRET=

# Only used by the explicit seed-admin command. Minimum 12 characters.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_DISPLAY_NAME=System Administrator
